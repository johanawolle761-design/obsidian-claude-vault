# Kopieren nach .env und ausfüllen. .env NIE committen, chmod 600 .env
# Werte erzeugen mit: openssl rand -hex 32

# Passwort zwischen Proxy und MCP-Server, verlässt den Server nie
MCP_AUTH_TOKEN=

# Kommt als Header x-api-key in den Claude-Connector
VAULT_AI_KEY=

# Token des Cloudflare Tunnels (Zero Trust > Networks > Tunnels > Docker)
TUNNEL_TOKEN=

# LAN- oder VPN-IP des Servers, auf der Syncthing lauscht (z. B. 192.168.1.50)
SYNC_BIND_IP=

# Eigener Linux-User (id -u / id -g)
PUID=1000
PGID=1000
